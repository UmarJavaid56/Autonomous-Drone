############################
# ROS2 Workspace Ignore
############################
# Build artifacts (colcon build output)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros2_ws/.colcon/
ros2_ws/.workspace/

# Top-level build artifacts (should not be tracked)
build/
install/
log/

# Python egg-info directories
*.egg-info/

############################
# ORB-SLAM3 Ignore
############################
ros2_ws/src/external/ORB_SLAM3/build/
ros2_ws/src/external/ORB_SLAM3/lib/
ros2_ws/src/external/ORB_SLAM3/CMakeCache.txt
ros2_ws/src/external/ORB_SLAM3/CMakeFiles/
ros2_ws/src/external/ORB_SLAM3/ORBvoc.txt

############################
# Pangolin Ignore
############################
Pangolin/build/
Pangolin/install/
Pangolin/CMakeFiles/
Pangolin/CMakeCache.txt

############################
# Python / Editor / OS
############################
*.pyc
__pycache__/
*.swp
*.swo
*.DS_Store
*.vscode/
*.idea/
# Python virtual environment
venv/
.venv/

############################
# CMake / Object Files
############################
*.o
*.so
*.a
*.out
*.cache

############################
# Workspace Generated Files
############################
*.log
*.tmp
*.bak
.ros/
