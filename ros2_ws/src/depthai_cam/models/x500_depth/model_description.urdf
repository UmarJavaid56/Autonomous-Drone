<?xml version="1.0" encoding="UTF-8"?>
<robot name="x500_depth">
  <!-- 
    URDF model for x500_depth drone - matches SDF model exactly
    This model uses the same meshes and poses as the Gazebo SDF.
    Meshes are referenced via package:// URIs for RViz compatibility.
  -->

  <!-- Main drone body (base_link) - from x500_base/model.sdf -->
  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02166666666666667" ixy="0" ixz="0" 
               iyy="0.02166666666666667" iyz="0" 
               izz="0.04000000000000001"/>
    </inertial>
    
    <!-- Main frame visual -->
    <visual name="base_link_visual">
      <origin xyz="0 0 0.025" rpy="0 0 3.141592654"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/NXP-HGD-CF.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <!-- Motor base 0 (front-right) -->
    <visual name="5010_motor_base_0">
      <origin xyz="0.174 0.174 0.032" rpy="0 0 -0.45"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <!-- Motor base 1 (rear-right) -->
    <visual name="5010_motor_base_1">
      <origin xyz="-0.174 0.174 0.032" rpy="0 0 -0.45"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <!-- Motor base 2 (front-left) -->
    <visual name="5010_motor_base_2">
      <origin xyz="0.174 -0.174 0.032" rpy="0 0 -0.45"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <!-- Motor base 3 (rear-left) -->
    <visual name="5010_motor_base_3">
      <origin xyz="-0.174 -0.174 0.032" rpy="0 0 -0.45"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <!-- Collision geometry - main body -->
    <collision name="base_link_collision_0">
      <origin xyz="0 0 0.007" rpy="0 0 0"/>
      <geometry>
        <box size="0.35355339059327373 0.35355339059327373 0.05"/>
      </geometry>
    </collision>
    
    <!-- Collision geometry - landing gear leg 1 -->
    <collision name="base_link_collision_1">
      <origin xyz="0 -0.098 -0.123" rpy="-0.35 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.21"/>
      </geometry>
    </collision>
    
    <!-- Collision geometry - landing gear leg 2 -->
    <collision name="base_link_collision_2">
      <origin xyz="0 0.098 -0.123" rpy="0.35 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.21"/>
      </geometry>
    </collision>
    
    <!-- Collision geometry - landing gear crossbar 1 -->
    <collision name="base_link_collision_3">
      <origin xyz="0 -0.132 -0.2195" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.015 0.015"/>
      </geometry>
    </collision>
    
    <!-- Collision geometry - landing gear crossbar 2 -->
    <collision name="base_link_collision_4">
      <origin xyz="0 0.132 -0.2195" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.015 0.015"/>
      </geometry>
    </collision>
  </link>

  <!-- Rotor 0 (front-left in NED / front-right in ENU) - CCW -->
  <link name="rotor_0">
    <inertial>
      <mass value="0.016076923076923075"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0" ixz="0" 
               iyy="2.6115851691700804e-05" iyz="0" 
               izz="2.649858234714004e-05"/>
    </inertial>
    
    <!-- Propeller visual - CCW -->
    <visual name="rotor_0_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/1345_prop_ccw.stl" 
              scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    
    <!-- Motor bell visual -->
    <visual name="rotor_0_visual_motor_bell">
      <origin xyz="0 0 -0.032" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision name="rotor_0_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor_0_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_0"/>
    <origin xyz="0.174 -0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rotor 1 (rear-right in NED / rear-left in ENU) - CCW -->
  <link name="rotor_1">
    <inertial>
      <mass value="0.016076923076923075"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0" ixz="0" 
               iyy="2.6115851691700804e-05" iyz="0" 
               izz="2.649858234714004e-05"/>
    </inertial>
    
    <!-- Propeller visual - CCW -->
    <visual name="rotor_1_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/1345_prop_ccw.stl" 
              scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    
    <!-- Motor bell visual -->
    <visual name="rotor_1_visual_motor_bell">
      <origin xyz="0 0 -0.032" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision name="rotor_1_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <origin xyz="-0.174 0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rotor 2 (front-right in NED / front-left in ENU) - CW -->
  <link name="rotor_2">
    <inertial>
      <mass value="0.016076923076923075"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0" ixz="0" 
               iyy="2.6115851691700804e-05" iyz="0" 
               izz="2.649858234714004e-05"/>
    </inertial>
    
    <!-- Propeller visual - CW -->
    <visual name="rotor_2_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/1345_prop_cw.stl" 
              scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    
    <!-- Motor bell visual -->
    <visual name="rotor_2_visual_motor_bell">
      <origin xyz="0 0 -0.032" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision name="rotor_2_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <origin xyz="0.174 0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rotor 3 (rear-left in NED / rear-right in ENU) - CW -->
  <link name="rotor_3">
    <inertial>
      <mass value="0.016076923076923075"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0" ixz="0" 
               iyy="2.6115851691700804e-05" iyz="0" 
               izz="2.649858234714004e-05"/>
    </inertial>
    
    <!-- Propeller visual - CW -->
    <visual name="rotor_3_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/1345_prop_cw.stl" 
              scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    
    <!-- Motor bell visual -->
    <visual name="rotor_3_visual_motor_bell">
      <origin xyz="0 0 -0.032" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision name="rotor_3_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <origin xyz="-0.174 -0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- OakD-Lite Camera link - from OakD-Lite/model.sdf -->
  <link name="camera_link">
    <inertial>
      <mass value="0.061"/>
      <origin xyz="0.00358 -0.03 0.014" rpy="0 0 0"/>
      <inertia ixx="0.0000460804" ixy="0" ixz="0" 
               iyy="0.0000055421" iyz="0" 
               izz="0.0000436519"/>
    </inertial>
    
    <!-- OakD-Lite mesh visual -->
    <visual name="OakD-Lite_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://depthai_cam/models/OakD-Lite/meshes/OakDLite.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision name="OakD-Lite_collision">
      <origin xyz="0.00358 -0.03 0.014" rpy="0 0 0"/>
      <geometry>
        <box size="0.0175 0.091 0.028"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera joint - matches x500_depth/model.sdf pose -->
  <joint name="CameraJoint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12 0.03 0.025" rpy="0 0 0"/>
  </joint>

</robot>
