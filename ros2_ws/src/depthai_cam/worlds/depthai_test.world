<?xml version="1.0"?>
<sdf version="1.9">
  <world name="depthai_test_world">
    <!-- Physics engine -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ambient light configuration -->
    <ambient>1 1 1 1</ambient>

    <!-- Sun light model -->
    <model name="sun">
      <static>true</static>
      <pose>5 5 10 0 0 0</pose>
      <link name="sun_link">
        <light name="sun" type="directional">
          <diffuse>1 1 1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <direction>0 0 -1</direction>
          <attenuation>
            <range>1000</range>
            <constant>0.9</constant>
            <linear>0.01</linear>
            <quadratic>0.001</quadratic>
          </attenuation>
          <cast_shadows>true</cast_shadows>
        </light>
      </link>
    </model>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1</mu><mu2>1</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start marker -->
    <model name="start_zone_marker">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.4 1.4 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.5 0.1 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>1.4 1.4 0.02</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Compact maze boundary (about half previous footprint) -->
    <model name="maze_wall_north">
      <static>true</static>
      <pose>5.5 2.6 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>13.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>13.0 0.2 2.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="maze_wall_south">
      <static>true</static>
      <pose>5.5 -2.6 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>13.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>13.0 0.2 2.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="maze_wall_west">
      <static>true</static>
      <pose>-1.0 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 5.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.2 5.2 2.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="maze_wall_east">
      <static>true</static>
      <pose>12.0 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 5.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.2 5.2 2.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- First half: classic wall maze -->
    <model name="maze_half_v1">
      <static>true</static>
      <pose>1.2 0.95 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 3.3 2.0</size></box></geometry>
          <material><ambient>0.55 0.22 0.22 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>0.2 3.3 2.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="maze_half_v2">
      <static>true</static>
      <pose>2.8 -0.95 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 3.3 2.0</size></box></geometry>
          <material><ambient>0.22 0.35 0.55 1</ambient><diffuse>0.3 0.5 0.8 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>0.2 3.3 2.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="maze_half_v3">
      <static>true</static>
      <pose>4.4 0.95 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 3.3 2.0</size></box></geometry>
          <material><ambient>0.55 0.22 0.22 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>0.2 3.3 2.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="maze_half_v4">
      <static>true</static>
      <pose>6.0 -0.95 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 3.3 2.0</size></box></geometry>
          <material><ambient>0.22 0.35 0.55 1</ambient><diffuse>0.3 0.5 0.8 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>0.2 3.3 2.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- Second half: different shape (cylindrical chicane) -->
    <model name="chicane_pillar_1">
      <static>true</static>
      <pose>7.4 0.9 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.95 0.65 0.2 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="chicane_pillar_2">
      <static>true</static>
      <pose>8.6 -0.9 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.85 1</ambient><diffuse>0.25 0.7 0.95 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="chicane_pillar_3">
      <static>true</static>
      <pose>9.8 0.9 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.95 0.65 0.2 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="chicane_pillar_4">
      <static>true</static>
      <pose>10.8 -0.7 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.85 1</ambient><diffuse>0.25 0.7 0.95 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.32</radius><length>2.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Finish marker -->
    <model name="finish_zone_marker">
      <static>true</static>
      <pose>11.1 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.4 1.4 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.7 1</ambient>
            <diffuse>0.2 0.4 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>1.4 1.4 0.02</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Physics plugin -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <!-- User commands (scene broadcaster) -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Scene broadcaster -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Sensors system - required for cameras (ogre2 needed for depth cameras) -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU system -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- Camera bridging handled via ros_gz_bridge in launch -->

    <!-- Explicit world frame model -->
    <model name="world_frame">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="world_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1e-6</mass>
          <inertia>
            <ixx>1e-9</ixx>
            <iyy>1e-9</iyy>
            <izz>1e-9</izz>
          </inertia>
        </inertial>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>

    <!-- Static odom frame model publishing TF (world -> odom) -->
    <model name="odom_frame">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="odom">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1e-6</mass>
          <inertia>
            <ixx>1e-9</ixx>
            <iyy>1e-9</iyy>
            <izz>1e-9</izz>
          </inertia>
        </inertial>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>

    <!-- Include X500 drone with depth camera -->
    <include>
      <uri>model://x500_depth</uri>
      <pose>0 0 0 0 0 0</pose>
      <name>x500_depth</name>
    </include>

  </world>
</sdf>
